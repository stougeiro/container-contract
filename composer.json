{
    "name": "stougeiro/container-contract",
    "description": "Interfaces and contracts for implementing dependency injection containers in PHP, covering lifecycle handling, service resolution and factory-based instantiation.",
    "type": "library",
    "minimum-stability": "stable",
    "prefer-stable": true,
    "license": "MIT",
    "authors": [
        {
            "name": "stougeiro",
            "email": "sidneytougeiro@gmail.com"
        }
    ],
    "keywords": [
        "container",
        "dependency injection",
        "di",
        "service container",
        "contracts",
        "interfaces",
        "psr",
        "framework",
        "agnostic",
        "php"
    ],
    "support": {
        "issues": "https://github.com/stougeiro/container-contract/issues",
        "source": "https://github.com/stougeiro/container-contract"
    },
    "funding": [
        {
            "type": "buymeacoffee",
            "url": "https://www.buymeacoffee.com/stougeiro"
        }
    ],
    "autoload": {
        "psr-4": {
            "STDW\\Contract\\Container\\": "src/"
        }
    },
    "require": {
        "php": ">=8.2",
        "psr/container": "^2.0"
    },
    "require-dev": {
        "phpstan/phpstan": "^2.2"
    }
}
